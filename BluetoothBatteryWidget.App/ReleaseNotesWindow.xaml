<Window x:Class="BluetoothBatteryWidget.App.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Title="Bloss 업데이트 안내">
    <Window.Resources>
        <Style x:Key="ReleaseNoteBulletTextStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ReleaseNoteConfirmButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#E6000000" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F0222222" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FF3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReleaseNoteCloseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#B8000000" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#EE222222" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#FF3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="26"
            BorderThickness="0"
            Background="Transparent"
            SnapsToDevicePixels="True">
        <Grid x:Name="RoundedContentRoot"
              ClipToBounds="True">
            <Grid x:Name="AbstractSignalBackdrop"
                  IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1" />
                </Grid.CacheMode>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HeroBackdropScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Grid.RenderTransform>
                <Image Source="Assets/release-notes-space.png"
                       Stretch="UniformToFill" />
            </Grid>

            <Grid x:Name="TileLayer"
                  IsHitTestVisible="False"
                  Opacity="0">
                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1" />
                </Grid.CacheMode>
            </Grid>

            <Rectangle x:Name="SoftSweep"
                       Width="220"
                       HorizontalAlignment="Left"
                       Opacity="0.05"
                       IsHitTestVisible="False">
                <Rectangle.CacheMode>
                    <BitmapCache RenderAtScale="1" />
                </Rectangle.CacheMode>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="SoftSweepTranslate"
                                        X="-360" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5"
                                         EndPoint="1,0.5">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#66FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <BlurEffect Radius="22" />
                </Rectangle.Effect>
            </Rectangle>

            <Rectangle Fill="#18000000" />

            <Grid Margin="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="20"
                        Background="Transparent"
                        BorderThickness="0">
                    <Grid>
                        <Ellipse x:Name="BrandCoreGlow"
                                 Width="142"
                                 Height="142"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="#E6000000"
                                 Stroke="#B8FFFFFF"
                                 StrokeThickness="1"
                                 Opacity="0.96">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="0"
                                                  Opacity="0.46"
                                                  Color="White" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <Ellipse x:Name="BrandRing"
                                 Width="166"
                                 Height="166"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stroke="#66FFFFFF"
                                 StrokeThickness="1"
                                 StrokeDashArray="4 7"
                                 Opacity="0.46" />

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="BLoss"
                                       FontSize="34"
                                       FontWeight="Black"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />
                            <Border Height="2"
                                    Width="72"
                                    Margin="0,9,0,0"
                                    Background="White"
                                    CornerRadius="1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="26,22"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="Transparent"
                        Background="#DD000000">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="VersionText"
                                       Text="Bloss"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock x:Name="HeadingText"
                                       Text="업데이트 내역"
                                       Margin="0,5,0,0"
                                       FontSize="31"
                                       FontWeight="Black"
                                       Foreground="White" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,21,0,14"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CleanupAutostartText"
                                       Text="Pico2W/DS5Dongle의 합성 USB 주소와 실제 DualSense 주소가 중복 표시되던 문제를 수정했습니다"
                                       FontWeight="Bold"
                                       Style="{StaticResource ReleaseNoteBulletTextStyle}" />
                            <TextBlock x:Name="SleepGuardText"
                                       Text="- 실제 DualSense 주소로 배터리와 이름·아이콘을 연결해 컨트롤러별로 기억합니다"
                                       Style="{StaticResource ReleaseNoteBulletTextStyle}" />
                            <TextBlock x:Name="CustomGuideTriggerText"
                                       Text="- Pico2W 한 대에는 한 번에 한 컨트롤러만 연결되며, 번갈아 연결하면 각각 개별 인식합니다"
                                       FontWeight="Bold"
                                       Style="{StaticResource ReleaseNoteBulletTextStyle}" />
                            <TextBlock x:Name="InstallUpdateValidationText"
                                       Text="- Pico2W가 여러 개이면 연결된 DualSense를 각각 동시에 표시할 수 있습니다"
                                       FontWeight="Bold"
                                       Style="{StaticResource ReleaseNoteBulletTextStyle}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterText"
                                       VerticalAlignment="Center"
                                       Text="확인을 누르면 이 안내는 다시 뜨지 않습니다."
                                       FontSize="12"
                                       Foreground="White"
                                       Opacity="0.78" />
                            <Button x:Name="ConfirmButton"
                                    Grid.Column="1"
                                    Width="92"
                                    Height="38"
                                    Margin="16,0,0,0"
                                    Style="{StaticResource ReleaseNoteConfirmButtonStyle}"
                                    Click="CloseButton_Click"
                                    Content="확인" />
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="0,12,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource ReleaseNoteCloseButtonStyle}"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close release notes">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               FontWeight="SemiBold"
                               LineHeight="14"
                               Text="&#xE711;"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
